{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "windows-mqtt",
  "mainBinaryName": "windows-mqtt",
  "version": "0.0.1",
  "identifier": "pro.popstas.windows-mqtt",
  "build": {
    "beforeDevCommand": "node scripts/prepare-frontend.js",
    "beforeBuildCommand": "node scripts/prepare-frontend.js",
    "frontendDist": "../frontend"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "../assets/trayicon.png"
    ],
    "windows": {
      "wix": {
        "enableElevatedUpdateTask": false
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "windows-mqtt",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ]
  }
}